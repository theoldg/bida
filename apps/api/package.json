{
  "name": "@bida/api",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dev": "wrangler deploy --env dev",
    "typecheck": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply hajsik --remote",
    "db:migrate:dev": "wrangler d1 migrations apply hajsik-dev --remote --env dev",
    "db:migrate:local": "wrangler d1 migrations apply hajsik --local",
    "test": "vitest run"
  },
  "dependencies": {
    "@bida/core": "workspace:*",
    "hono": "^4.6.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250127.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "wrangler": "^4.0.0"
  }
}
