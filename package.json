{
  "name": "bida",
  "version": "1.0.20",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "git config core.hooksPath .githooks || true",
    "session": "pnpm install && sh scripts/on-dev.sh",
    "release": "sh scripts/release.sh",
    "bump": "node scripts/version.mjs",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "docs": "node scripts/docs-check.mjs",
    "rules": "node scripts/rules-check.mjs",
    "check": "node scripts/check.mjs",
    "verify": "node scripts/verify.mjs",
    "entries": "node scripts/entries-check.mjs",
    "offline": "node scripts/offline-check.mjs",
    "claim": "node scripts/claim-check.mjs",
    "keyboard": "node scripts/keyboard-check.mjs",
    "stall": "node scripts/stall-check.mjs",
    "homescreen": "node scripts/homescreen-check.mjs",
    "nav": "node scripts/nav-check.mjs",
    "demo": "node scripts/demo-check.mjs",
    "shots": "node scripts/shots.mjs",
    "readme-shots": "node scripts/readme-shots.mjs",
    "icons": "node scripts/icons.mjs",
    "drive": "node scripts/drive.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.62.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
