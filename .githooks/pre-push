#!/bin/sh
# Everything CI-shaped, on the machine making the push
# (docs/standing-instructions.md#workflow). The deploy workflow
# (.github/workflows/deploy.yml) only rebuilds and ships, so a build failing
# there would fail on `main` with nothing to gate it.
#
# A pass is stamped against its tree (scripts/lib/check-stamp.mjs), so
# `pnpm check` then `git push` pays for the gate once — no reason to reach
# for `--no-verify`.
#
# Wired up by the root postinstall (`git config core.hooksPath .githooks`),
# so `pnpm install` is all a fresh clone needs.
set -e
pnpm check
