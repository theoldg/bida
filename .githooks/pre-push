#!/bin/sh
# The checks that take seconds, on the machine making the push, so a mistake
# is found before it leaves; the build and the browser checks run on GitHub
# (docs/testing.md#where-each-check-runs).
#
# A pass is stamped against its tree (scripts/lib/check-stamp.mjs), so
# `pnpm check` then `pnpm push` pays for the gate once — no reason to reach
# for `--no-verify`.
#
# Wired up by the root postinstall (`git config core.hooksPath .githooks`),
# so `pnpm install` is all a fresh clone needs.
#
# A push that passes releases the main clone's claim (scripts/on-dev.sh); in a
# worktree there is no BUSY to remove.
set -e
pnpm check
rm -f BUSY
